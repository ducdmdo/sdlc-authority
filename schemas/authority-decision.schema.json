{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ducdmdo/sdlc-authority/schemas/authority-decision.schema.json",
  "title": "Attested authority decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "relay",
    "authority",
    "decision",
    "verification",
    "approvalEvidence",
    "issuedAt",
    "expiresAt",
    "privacyProfile"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "request": {"$ref": "authority-request.schema.json"},
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runAttempt", "actor"],
      "properties": {
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "actor": {"const": "ducdmdo"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow",
        "environment",
        "commitSha",
        "ref",
        "refProtected",
        "runId",
        "runAttempt",
        "actor"
      ],
      "properties": {
        "repository": {"const": "ducdmdo/sdlc-authority"},
        "workflow": {"const": ".github/workflows/issue-authority-receipt.yml"},
        "environment": {"const": "human-approval"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ref": {"const": "refs/heads/main"},
        "refProtected": {"const": true},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "actor": {"const": "github-actions[bot]"}
      }
    },
    "decision": {"const": "accepted"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "isolation", "entrypointContract"],
      "properties": {
        "result": {"const": "passed"},
        "isolation": {"const": "bubblewrap-network-none-v1"},
        "entrypointContract": {"const": "fixed-v1"}
      }
    },
    "approvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configDigest", "reviewDigest"],
      "properties": {
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviewDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "privacyProfile": {"const": "opaque-commitments-only-v1"}
  }
}
